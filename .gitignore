node_modules/
.next/
__pycache__/
*.pyc
.env
.env.local
venv/
.DS_Store
*.sql
# schema drafts under docs/ are source, not DB dumps — keep them tracked
!docs/*.sql
# same for migrations: these are DDL we author, and carry no member data
!engine/db/*.sql
*.db
.gstack

# Local-only, confidential reference material — NEVER commit.
# Conductor workspaces get _local via symlink (scripts/conductor-setup.sh),
# so it stays a single uncommitted copy in the root clone. No trailing
# slash on _local/.gstack: that would match directories only, leaving the
# symlinked versions untracked and committable in every workspace.
/_local
.venv/
