# Without this file the Vercel CLI falls back to .gitignore, which excludes
# _local/ and .venv/ - fine today, but it makes what gets uploaded depend on a
# file written for git. Be explicit instead.
.venv
__pycache__
*.pyc
tests
Dockerfile
.dockerignore
